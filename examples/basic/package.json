{
  "name": "waku-fastify-example",
  "version": "1.0.0",
  "description": "Example project for waku-fastify plugin",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/dev.ts",
    "build": "waku build && esbuild server/prod.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/main.js",
    "start": "NODE_ENV=production node dist/main.js",
    "preview": "pnpm build && pnpm start"
  },
  "keywords": [
    "waku",
    "fastify",
    "react"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "fastify": "^5.0.0",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "waku": "^1.0.0-alpha.0",
    "waku-fastify": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
