{
  "name": "waku-fastify",
  "description": "Fastify plugin for Waku React framework",
  "version": "0.1.1",
  "license": "MIT",
  "author": "Aaron Zhou",
  "keywords": [
    "waku",
    "fastify"
  ],
  "packageManager": "pnpm@10.24.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "test": "vitest",
    "test:update": "vitest --update",
    "test:run": "vitest --run --changed",
    "test:coverage": "vitest --coverage",
    "example:basic": "pnpm --filter waku-fastify-example",
    "typecheck": "tsc --noEmit",
    "format": "eslint --fix --cache src/**/*.ts",
    "prepare": "husky install",
    "uninstall-husky": "npm uninstall husky --no-save && git config --unset core.hooksPath && npx rimraf .husky",
    "release": "commit-and-tag-version"
  },
  "dependencies": {
    "@fastify/middie": "^9.0.3",
    "@fastify/static": "^8.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitejs/plugin-rsc": "^0.5.11",
    "@whatwg-node/server": "^0.10.17",
    "cache-parser": "^1.2.6",
    "fastify-plugin": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.4",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "@vitest/coverage-v8": "^4.0.15",
    "commit-and-tag-version": "12.4.1",
    "conventional-changelog-aaron-preset": "^0.3.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-regexp": "^2.10.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.2.6",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-externalize-deps": "^0.10.0",
    "vitest": "^4.0.15",
    "waku": "^1.0.0-alpha.1"
  },
  "peerDependencies": {
    "fastify": "^5.0.0",
    "vite": "^6.0.0 || ^7.0.0",
    "waku": "^1.0.0-alpha.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
